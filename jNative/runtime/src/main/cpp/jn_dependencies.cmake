# Inspect target images with the selected toolchain's host utilities. Never run them.
function(jn_copy_runtime_dependencies images kind system objdump output)
    if(system STREQUAL "Windows")
        set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM "windows+pe")
    elseif(system STREQUAL "Linux")
        set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM "linux+elf")
    else()
        set(${output} "" PARENT_SCOPE)
        return()
    endif()
    if(objdump)
        set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL "objdump")
        set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${objdump}")
    endif()
    if(kind STREQUAL "SHARED_LIBRARY")
        set(image_type LIBRARIES)
    else()
        set(image_type EXECUTABLES)
    endif()
    file(GET_RUNTIME_DEPENDENCIES ${image_type} ${images}
        RESOLVED_DEPENDENCIES_VAR dependencies UNRESOLVED_DEPENDENCIES_VAR unresolved
        DIRECTORIES ${JNATIVE_RUNTIME_LIBRARY_DIRECTORIES}
        PRE_EXCLUDE_REGEXES "api-ms-.*" "ext-ms-.*"
        POST_EXCLUDE_REGEXES ".*[Ww][Ii][Nn][Dd][Oo][Ww][Ss][/\\\\].*" "^/lib/.*" "^/lib64/.*" "^/usr/lib/.*")
    if(unresolved)
        message(FATAL_ERROR "Unresolved runtime libraries: ${unresolved}. Add their directories to JNATIVE_RUNTIME_LIBRARY_DIRECTORIES.")
    endif()
    list(GET images 0 primary)
    get_filename_component(destination "${primary}" DIRECTORY)
    set(copied "")
    foreach(dependency IN LISTS dependencies)
        get_filename_component(name "${dependency}" NAME)
        if(NOT dependency STREQUAL "${destination}/${name}")
            configure_file("${dependency}" "${destination}/${name}" COPYONLY)
        endif()
        list(APPEND copied "${destination}/${name}")
    endforeach()
    set(${output} "${copied}" PARENT_SCOPE)
endfunction()
